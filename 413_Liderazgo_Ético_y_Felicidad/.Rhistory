Aspecto <- c(
'Nombre del plan estratégico',
'Dimensión de la rueda de la vida del proyecto',
'Responsable último del proyecto',
'¿Por qué y para qué voy a hacerlo?',
'¿Qué valores quiero plasmar en los cómos?',
'¿Qué voy a hacer (acción, tiempo y lugar)?',
'¿Cuándo lo voy a hacer (inicio y fín)?',
'¿Quiénes lo vamos a hacer?',
'¿Qué recusros son necesarios?',
'¿Con qué adversidades y limitaciones me puedo encontrar?'
)
Descripción <- c(
'Cuerpo Sano: Fuerza y Confianza',
'Física',
'Fernando Aleisy Gonzalez',
'Porque debo aumentar la energía disponible para mis actividades diarias y la salud a largo plazo y para sentirme seguro, prevenir enfermedades y disfrutar actividades físicas.',
'Constancia, autoaceptación, resiliencia.',
'Utilizar las instalciones deportivas de la universidad para salir a correr, preferiblemente en las mañanas',
'El tiempo de inicio depende del siguiente semestre y se espera a seguir indefinidamente',
'Fernando Aleisy Gonzalez y posiblente algún compañero de trabajo que le guste la idea',
'Vestimenta para deportes (sudedara) y tenis',
'La universidad se encuentra en una vereda (caserio alejado de la ciudad), por lo que llegar temprano puede ser difícil'
)
df_plan_fisico <- data.frame(Aspecto, Descripción)
tabla_plan_fisico <- kbl(df_plan_fisico,
caption = 'Plan estratégico para alcanzar los deseos y superar las molestias de la dimensión física',
label = 'plan_fisico',
